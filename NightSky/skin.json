            "views",
            "actions",
            "variants",
            "notifications",
            "user-interface-preferences",
            "user-page",
            "user-menu"
          ],
          "messages": [
            "sitetitle",
            "search",
            "tagline",
            "navigation-heading",
            "nightsky-skip",
            "nightsky-page-tools",
            "nightsky-associated-pages",
            "nightsky-user-page",
            "nightsky-notifications",
            "nightsky-preferences"
          ],
          "styles": [
            "skins.nightsky.styles"
          ],
          "scripts": [
            "skins.nightsky"
          ]
        }
      ]
    }
  },
  "MessagesDirs": {
    "NightSky": [
      "i18n"
    ]
  },
  "ResourceModules": {
    "skins.nightsky.styles": {
      "class": "MediaWiki\\ResourceLoader\\SkinModule",
      "features": {
        "normalize": true,
        "elements": true,
        "content-tables": true,
        "content-links": true,
        "content-media": true,
