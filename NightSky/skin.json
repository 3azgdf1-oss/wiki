    "skins.nightsky": {
      "scripts": [
        "resources/navigation.js"
      ]
    }
  },
  "ResourceFileModulePaths": {
    "localBasePath": "",
    "remoteSkinPath": "NightSky"
  },
  "manifest_version": 2
}
