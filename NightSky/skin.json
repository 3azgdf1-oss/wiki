{
  "name": "NightSky",
  "version": "1.1.0",
  "type": "skin",
  "namemsg": "skinname-nightsky",
  "descriptionmsg": "nightsky-desc",
  "requires": {
    "MediaWiki": ">= 1.46.0"
  },
  "ValidSkinNames": {
    "nightsky": {
